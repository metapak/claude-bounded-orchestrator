#!/bin/sh

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
launcher="$launcher_dir/launchers/launch_dashboard.py"

if [ ! -f "$launcher" ]; then
    if selected_dir=$(/usr/bin/osascript -e 'POSIX path of (choose folder with prompt "Choose the extracted Claude Bounded Orchestrator folder")' 2>&1); then
        launcher_dir=${selected_dir%/}
        launcher="$launcher_dir/launchers/launch_dashboard.py"
        app_plist="$launcher_dir/launchers/Bounded Orchestrator.app/Contents/Info.plist"
        bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_plist" 2>/dev/null)
        if [ ! -f "$launcher" ] || [ ! -f "$launcher_dir/scripts/configure.py" ] || [ "$bundle_id" != "local.claude-bounded-orchestrator.launcher" ]; then
            /usr/bin/osascript -e 'display alert "Setup console unavailable" message "Choose the extracted Claude Bounded Orchestrator folder that contains launchers and scripts." as warning'
            exit 1
        fi
    else
        case "$selected_dir" in
            *"(-128)"*) exit 0 ;;
        esac
        /usr/bin/osascript -e 'on run argv' -e 'display alert "Could not choose the extracted folder" message (item 1 of argv) as warning' -e 'end run' "$selected_dir"
        exit 1
    fi
fi

for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3.13 python3.12 python3.11 python3; do
    if command -v "$python" >/dev/null 2>&1 &&
        "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$python" "$launcher"
    fi
done

/usr/bin/osascript -e 'display alert "Python 3.11 or newer is needed" message "Install Python 3.11 or newer, then open Bounded Orchestrator again." as warning'
