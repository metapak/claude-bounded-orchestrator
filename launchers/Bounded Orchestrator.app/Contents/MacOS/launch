#!/bin/sh

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")/../../../.." && pwd)
launcher="$launcher_dir/launchers/launch_dashboard.py"

if [ ! -f "$launcher" ]; then
    guide=$(/usr/bin/osascript -e 'display dialog "Önce İndirilenler klasöründe ZIP dosyasından çıkan kurulum paketini bulacağız. Bu klasör uygulamanın çalışması için gereken launchers ve scripts klasörlerini içerir. Sonraki adımda Claude Code kullandığınız projeyi seçeceksiniz. / First find the extracted setup package in Downloads. It contains launchers and scripts. Next, choose the project where you use Claude Code." buttons {"Vazgeç / Cancel", "Devam / Continue"} default button "Devam / Continue" cancel button "Vazgeç / Cancel" with title "1/2 Kurulum paketi / Setup package"' 2>&1)
    guide_status=$?
    if [ "$guide_status" -ne 0 ]; then
        case "$guide" in *-128*) exit 0 ;; esac
        /usr/bin/osascript -e 'display alert "Kurulum konsolu açılamadı / Setup console unavailable" message "Kurulum adımı açılamadı / Could not show the setup step." as warning'
        exit 1
    fi
    while :; do
        selected=$(/usr/bin/osascript -e 'POSIX path of (choose folder with prompt "1/2 Kurulum paketinin klasörünü seçin (içinde launchers ve scripts var) / Select the extracted setup folder containing launchers and scripts")' 2>&1)
        choice_status=$?
        if [ "$choice_status" -ne 0 ]; then
            case "$selected" in
                *-128*)
                    /usr/bin/osascript -e 'display alert "Kurulum iptal edildi / Setup canceled" message "Kurulum paketinin klasörünü seçerek yeniden deneyebilirsiniz / Reopen the app to choose the setup folder."'
                    exit 0
                    ;;
            esac
            /usr/bin/osascript -e 'display alert "Kurulum konsolu açılamadı / Setup console unavailable" message "Kurulum paketinin klasörü seçilemedi / Could not choose the setup folder." as warning'
            exit 1
        fi
        case "$selected" in
            */launchers/) selected=${selected%/launchers/} ;;
            */launchers) selected=${selected%/launchers} ;;
        esac
        app_plist="$selected/launchers/Bounded Orchestrator.app/Contents/Info.plist"
        bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app_plist" 2>/dev/null)
        if [ -f "$selected/launchers/launch_dashboard.py" ] && [ -f "$selected/scripts/configure.py" ] && [ "$bundle_id" = "local.claude-bounded-orchestrator.launcher" ]; then
            launcher="$selected/launchers/launch_dashboard.py"
            break
        fi
        /usr/bin/osascript -e 'display alert "Yanlış klasör / Wrong folder" message "Bu ilk adımda projenizi değil, içinde launchers ve scripts bulunan çıkarılmış Claude Code kurulum paketini seçin. Ardından Git projenizi seçeceksiniz. / First select the extracted Claude Code setup folder containing launchers and scripts. The Git project comes next." as warning'
    done
fi

for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 python3.13 python3.12 python3.11 python3; do
    if command -v "$python" >/dev/null 2>&1 &&
        "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$python" "$launcher"
    fi
done

/usr/bin/osascript -e 'display alert "Python 3.11 or newer is needed" message "Install Python 3.11 or newer, then open Bounded Orchestrator again." as warning'
